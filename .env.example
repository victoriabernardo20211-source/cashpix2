# Copy this to .env and fill in your values
PORT=3000
NODE_ENV=development

# JWT secret - use a long random string in production
JWT_SECRET=troque-por-uma-chave-secreta-longa-aqui

# Admin secret path - this IS the URL to access the admin panel
# NEVER use /admin or /painel - use a random string only you know
# Example: if ADMIN_SECRET_PATH=gx9k2m7p, admin is at yoursite.com/gx9k2m7p
ADMIN_SECRET_PATH=gx9k2m7p

# Database path
DB_PATH=./cashpix.db
