# Porta local (Vercel ignora isso)
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# URL secreta do painel admin (NÃO use /admin ou /painel)
# Mude para algo aleatório antes de subir em produção!
ADMIN_SECRET_PATH=gx9k2m7p

# Segredo para assinar os tokens JWT
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-forte-aqui

# URL do banco PostgreSQL (Neon, Supabase, Railway, etc.)
# Exemplo Neon: postgresql://user:senha@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname
